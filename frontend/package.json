{
  "name": "zhizhida-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "typecheck": "tsc --noEmit",
    "contract:generate": "node ../scripts/api-contract.mjs generate",
    "contract:check": "node ../scripts/api-contract.mjs check && tsc --noEmit",
    "test": "node --import ./scripts/test-environment.mjs --experimental-strip-types --test src/api/request.test.mjs src/stores/accountIsolation.test.mjs src/pages/Interview/pendingAnswer.test.mjs src/pages/Interview/sessionController.test.mjs src/components/resume/optimizationController.test.mjs src/pages/Resumes/Editor/editorController.test.mjs src/pages/Interview/interviewSettings.test.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "antd": "^5.18.3",
    "axios": "^1.7.2",
    "dayjs": "^1.11.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.25.1",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.17.0",
    "@typescript-eslint/parser": "^7.17.0",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.8",
    "postcss": "^8.4.41",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^8.1.4"
  }
}
