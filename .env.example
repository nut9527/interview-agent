# Docker 部署：仅前端 80 端口对公网开放，后端和 MySQL 默认只绑定本机。
FRONTEND_BIND_ADDRESS=0.0.0.0
FRONTEND_PORT=80
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8080
MYSQL_BIND_ADDRESS=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=zhizhida
MYSQL_USER=zhizhida
# 可指定已缓存的 MySQL 8.4 镜像。未指定时启动器优先 Docker Hub，失败后尝试官方 ECR。
# MYSQL_IMAGE=mysql:8.4
# 正式部署前请在 .env 中设置强密码；不要提交 .env。
# MYSQL_PASSWORD=请替换为本地密码
# MYSQL_ROOT_PASSWORD=请替换为本地密码

# AI：复制为项目根目录的 .env，并填写本地密钥；不要提交 .env。
AI_PROVIDER=mock
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_THINKING=
DEEPSEEK_TIMEOUT_SECONDS=30
# 单个后端实例共享的 AI 容量和熔断配置
AI_MAX_CONCURRENT_CALLS=4
AI_FAILURE_THRESHOLD=3
AI_CIRCUIT_OPEN_SECONDS=30

# MySQL 共享额度：匿名入口按直连 IP；认证入口按用户 ID。工作单位是预留调用成本，非实际账单金额。
QUOTA_REGISTER_PER_MINUTE=3
QUOTA_REGISTER_PER_DAY=10
QUOTA_LOGIN_PER_MINUTE=10
QUOTA_LOGIN_PER_DAY=60
QUOTA_DEMO_PER_HOUR=6
QUOTA_DEMO_PER_DAY=6
QUOTA_AI_PER_MINUTE=5
QUOTA_AI_UNITS_PER_DAY=40
QUOTA_AI_GLOBAL_UNITS_PER_DAY=400
DEMO_CLEANUP_BATCH_SIZE=25
DEMO_CLEANUP_INTERVAL_MS=60000

# 监控专用 Bearer 凭据；留空时 /actuator/** 拒绝访问，不能用普通用户 Token 代替。
# 本地填写高熵随机值，不提交实际凭据；仅从受控内网采集。
METRICS_TOKEN=

# 本地开发页面端口；FRONTEND_PORT 仅用于 Docker Nginx。
DEV_FRONTEND_PORT=5173
# 使用已有 MySQL 时，设置以下变量并运行 node scripts/dev.mjs --external-db。
# SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/zhizhida?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
# SPRING_DATASOURCE_USERNAME=zhizhida
# SPRING_DATASOURCE_PASSWORD=请替换为本地密码
