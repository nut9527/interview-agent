# 复制为项目根目录 .env；不要提交密钥或实际凭据。
# 本地启动器读取全部键值；Docker 仅传入 Compose environment 中明确列出的项。
# 标准 Compose 内置 BGE 与 pgvector，见 docs/启动与故障排查.md。
# Docker 部署：仅前端 80 端口对公网开放，后端和 MySQL 默认只绑定本机。
FRONTEND_BIND_ADDRESS=0.0.0.0
FRONTEND_PORT=80
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8080
MYSQL_BIND_ADDRESS=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=zhizhida
MYSQL_USER=zhizhida
# 可指定已缓存的 MySQL 8.4 镜像。未指定时启动器优先 Docker Hub，失败后尝试官方 ECR。
# MYSQL_IMAGE=mysql:8.4
# 正式部署前请在 .env 中设置强密码；不要提交 .env。
# MYSQL_PASSWORD=请替换为本地密码
# MYSQL_ROOT_PASSWORD=请替换为本地密码

# AI：默认 Mock，无需密钥；真实模型使用 deepseek 并填写下面的本地密钥。
AI_PROVIDER=mock
# 默认启用只读技术资料 MCP；Compose 用内部服务名，源码启动器管理回环进程。
# MCP_PORT=18091
# AGENT_MCP_REFERENCE_ENABLED=false
# 源码模式显式指定回环 URL 时，由操作者启动对应服务。
# AGENT_MCP_REFERENCE_URL=http://127.0.0.1:18091/mcp
# 标准 Compose 默认启用 512 维 BGE；本机源码模式先运行 node scripts/enable-rag.mjs。
# 手动部署需配置 embedding 服务和 PostgreSQL，并按 scripts/sql/knowledge-vectors.sql 建表。
# AGENT_VECTOR_ENABLED=false
AGENT_VECTOR_MIN_SCORE=0.55
# 混合检索：RRF k=1..1000，两路候选数=1..100，每章节优先名额=1..20；不足时补齐。
AGENT_RETRIEVAL_RRF_K=60
AGENT_RETRIEVAL_LEXICAL_TOP_N=30
AGENT_RETRIEVAL_VECTOR_TOP_N=30
AGENT_RETRIEVAL_MAX_PER_HEADING=2
AGENT_VECTOR_WORKER_ENABLED=true
AGENT_VECTOR_POLL_MS=5000
# AGENT_VECTOR_EMBEDDING_URL=http://127.0.0.1:18092/v1
# AGENT_VECTOR_EMBEDDING_MODEL=bge-small-zh-v1.5-q
# 预处理或模型版本变化时更新此值；更换维度需准备兼容的表或数据库。
# AGENT_VECTOR_EMBEDDING_VERSION=bge-zh-v15-q-local-v1
# AGENT_VECTOR_DIMENSION=512
# AGENT_VECTOR_PG_HOST=127.0.0.1
# AGENT_VECTOR_PG_PORT=15432
# AGENT_VECTOR_PG_DATABASE=agent_vectors
# AGENT_VECTOR_PG_USER=agent_vectors
# AGENT_VECTOR_PG_PASSWORD=
# VECTOR_POSTGRES_PASSWORD=设置容器向量库管理密码
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_THINKING=
DEEPSEEK_TIMEOUT_SECONDS=30
# 全部 API / Worker 共享的 AI 并发上限；所有副本必须使用同一协调 Redis、namespace 和限额。
AI_MAX_CONCURRENT_CALLS=4
AI_FAILURE_THRESHOLD=3
AI_CIRCUIT_OPEN_SECONDS=30

# MySQL 共享额度：匿名入口按直连 IP；认证入口按用户 ID。工作单位是预留调用成本，非实际账单金额。
QUOTA_REGISTER_PER_MINUTE=3
QUOTA_REGISTER_PER_DAY=10
QUOTA_LOGIN_PER_MINUTE=10
QUOTA_LOGIN_PER_DAY=60
QUOTA_DEMO_PER_HOUR=6
QUOTA_DEMO_PER_DAY=6
QUOTA_AI_PER_MINUTE=5
QUOTA_AI_UNITS_PER_DAY=40
QUOTA_AI_GLOBAL_UNITS_PER_DAY=400
DEMO_CLEANUP_BATCH_SIZE=25
DEMO_CLEANUP_INTERVAL_MS=60000
# 演示空间独立且限时；普通注册账号不会导入演示样例。
DEMO_ENABLED=true
DEMO_SANDBOX_TTL_HOURS=4
DEMO_MAX_ACTIVE_SANDBOXES=100

# 监控专用 Bearer 凭据；留空时 /actuator/** 拒绝访问，不能用普通用户 Token 代替。
# 本地填写高熵随机值，不提交实际凭据；仅从受控内网采集。
METRICS_TOKEN=

# 标准 Compose 和源码启动器默认启用题目快照缓存、提交频控和任务投递。
# --external-db 只使用显式启用的 Redis / RocketMQ，适合已有数据库的本地开发。
# QUESTION_CACHE_ENABLED=true
# REDIS_RATE_LIMIT_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# 独立实例，不能仅改逻辑数据库；旧 REDIS_* 连接项仅作为频控配置的兼容默认值。
REDIS_CACHE_HOST=127.0.0.1
REDIS_CACHE_PORT=6380
REDIS_CACHE_USERNAME=
REDIS_CACHE_PASSWORD=
REDIS_CACHE_DATABASE=0
REDIS_CACHE_SSL=false
REDIS_CACHE_CONNECT_TIMEOUT=500ms
REDIS_CACHE_TIMEOUT=300ms
# 若需要覆盖旧 REDIS_HOST/PORT/PASSWORD，单独设置 REDIS_RATE_HOST/PORT/PASSWORD。
# REDIS_RATE_HOST=127.0.0.1
# REDIS_RATE_PORT=6379
# REDIS_RATE_PASSWORD=
REDIS_RATE_USERNAME=
REDIS_RATE_DATABASE=0
REDIS_RATE_SSL=false
REDIS_RATE_CONNECT_TIMEOUT=500ms
REDIS_RATE_TIMEOUT=300ms
REDIS_NAMESPACE=zhizhida:dev
REDIS_SUBMISSION_LIMIT=10
REDIS_SUBMISSION_WINDOW_MS=10000
# 源码启动器可覆盖面试任务分发方式，标准 Compose 使用 rocketmq。
# RUN_DISPATCH_MODE=rocketmq
RUN_DISPATCH_CONCURRENCY=2
ROCKETMQ_PROXY_PORT=8081
# 源码启动默认连接 127.0.0.1:<ROCKETMQ_PROXY_PORT>；外置代理可显式覆盖。
# ROCKETMQ_ENDPOINTS=127.0.0.1:8081
ROCKETMQ_RESOURCE_PREFIX=zhizhida
# ROCKETMQ_ACCESS_KEY=
# ROCKETMQ_SECRET_KEY=
# ROCKETMQ_TLS_ENABLED=false
# 消费端长轮询时长须落在 Proxy 允许的范围内，内置 Proxy 的下限为 200 毫秒。
# ROCKETMQ_RECEIVE_WAIT_MS=200
INTERVIEW_RUNS_WORKER_ENABLED=true
# 单实例运行容量；outstanding 包括执行、首次排队和退避，防止重试撑大等待队列。
INTERVIEW_RUNS_MAX_ACTIVE=4
INTERVIEW_RUNS_MAX_OUTSTANDING=20
INTERVIEW_RUNS_QUEUE_SECONDS=10
# 生产仅允许 TOOL+A1；B0/S1/S3、FIXED/LEGACY 仅用于测试与 agent-evaluation。
INTERVIEW_RUNS_LOOP_POLICY=A1
# 仅支持 phased-v2；升级前结束或取消在途任务，旧协议检查点不可恢复。
INTERVIEW_RUNS_DECISION_PROTOCOL=phased-v2
# 开放跨会话记忆工具；仍需用户在学习偏好中允许历史使用。
LEARNING_PRACTICE_TOOLS_ENABLED=true
RUN_OUTBOX_PUBLISHER_ENABLED=true
# 有界顺序投递；批大小范围 1..32，时间预算范围 1..1000ms。
RUN_OUTBOX_PUBLISHER_INTERVAL_MS=500
RUN_OUTBOX_PUBLISHER_BATCH_SIZE=8
RUN_OUTBOX_PUBLISHER_BATCH_BUDGET_MS=100
RUN_RECOVERY_ENABLED=true

# 标准 Compose 通过 MQ 派发知识任务；源码启动器默认跟随面试任务分发方式。
# 本机双进程须指向同一绝对共享路径；多主机须挂载同一持久共享文件系统。
# KNOWLEDGE_DISPATCH_MODE=rocketmq
# KNOWLEDGE_IMPORT_SHARED_DIRECTORY=D:/path/to/zhizhida/.runtime/knowledge-shared
KNOWLEDGE_IMPORT_CONCURRENCY=2
KNOWLEDGE_INDEX_CONCURRENCY=1
# 排队、执行、重试共用此截止预算；最大 1800 秒，不随重启刷新。
KNOWLEDGE_IMPORT_TIMEOUT_SECONDS=180

# 本地开发页面端口；FRONTEND_PORT 仅用于 Docker Nginx。
DEV_FRONTEND_PORT=5173
# 使用已有 MySQL 时，设置以下变量并运行 node scripts/dev.mjs --external-db。
# SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/zhizhida?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
# SPRING_DATASOURCE_USERNAME=zhizhida
# SPRING_DATASOURCE_PASSWORD=请替换为本地密码

# Agent 追踪：默认仅本地关联，不向收集器发送数据；开启前配置获准的 OTLP HTTP 端点。
AGENT_TRACE_EXPORT_ENABLED=false
AGENT_TRACE_SAMPLE_PROBABILITY=0.1
AGENT_TRACE_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces

# SSE 集群总连接数 / 单用户连接数；连接两分钟到期后通过事件游标重连。
INTERVIEW_SSE_MAX_CONNECTIONS=64
INTERVIEW_SSE_MAX_CONNECTIONS_PER_OWNER=3
# 练习模式允许模型重排未覆盖能力；仅影响新建普通面试，正式考试/专项训练保持原策略。
INTERVIEW_ADAPTIVE_ROUTING_ENABLED=true
